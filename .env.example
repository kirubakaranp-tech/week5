# Copy this file to .env. Only needed on Windows when Tesseract or Poppler is not on your PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\poppler\Library\bin

# Redis for Celery (Task 6)
REDIS_URL=redis://localhost:6379/0

# Jira connector (Task 7)
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT=HR

# Company database for the SQL templates (Task 7)
DATABASE_ADMIN_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres
READONLY_DATABASE_URL=postgresql://company_readonly:CHOOSE_A_PASSWORD@localhost:5432/company_db

# LLM that fills in the template parameters (Groq free plan)
OPENAI_API_KEY=your-groq-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
